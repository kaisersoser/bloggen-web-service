# ============================================
# FRONTEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env for local development
# Fill in the actual values before starting the frontend

# ============================================
# DATABASE - Local PostgreSQL
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bloggen_dev"

# ============================================
# PROTOCOL CONFIGURATION - HTTPS (Development)
# ============================================
NEXT_PUBLIC_PROTOCOL_MODE=https
NEXT_PUBLIC_FRONTEND_HOST=localhost
NEXT_PUBLIC_FRONTEND_PORT=3001
NEXT_PUBLIC_BACKEND_HOST=localhost
NEXT_PUBLIC_BACKEND_PORT=5000

# ============================================
# NEXTAUTH CONFIGURATION - Local Development
# ============================================
# NEXTAUTH_URL should match your frontend URL
NEXTAUTH_URL="https://localhost:3001"

# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-min-32-characters"

# ============================================
# BACKEND API CONFIGURATION - HTTPS
# ============================================
API_BASE_URL="https://localhost:5000"
NEXT_PUBLIC_API_URL="https://localhost:5000"
NEXT_PUBLIC_WS_URL="wss://localhost:5000"

# ============================================
# OAUTH PROVIDERS - Development
# ============================================
# Google OAuth - Get credentials from: https://console.cloud.google.com/
# Navigate to: APIs & Services > Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth - Get credentials from: https://github.com/settings/developers
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# Microsoft OAuth - Get credentials from: https://portal.azure.com/
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"

# ============================================
# SUPABASE CONFIGURATION (Optional - for production use)
# ============================================
# Uncomment these if using Supabase instead of local PostgreSQL
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ============================================
# LOGGING CONFIGURATION
# ============================================
# LOG_LEVEL: Server-side logging (error/warn/info/debug)
# NEXT_PUBLIC_LOG_LEVEL: Client-side console logging
# Recommended: Keep at warn for normal development
LOG_LEVEL=warn
NEXT_PUBLIC_LOG_LEVEL=warn

# Verbose frontend logging (set to true for detailed debugging only)
NEXT_PUBLIC_ENABLE_VERBOSE_LOGGING=false

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL="https://localhost:3001"
NEXT_PUBLIC_ENVIRONMENT=development

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Update DATABASE_URL if using different credentials
# 3. Generate NEXTAUTH_SECRET: openssl rand -base64 32
# 4. Add your Google OAuth credentials (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET)
# 5. Optionally add GitHub/Microsoft OAuth credentials
# 6. Run: npm run dev
