# Frontend Environment Configuration - STAGING (Windows Docker)
# This file is used when running staging environment on Windows via Docker Compose

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# **ACTION REQUIRED**: Replace with your staging database URL
# Should match backend DATABASE_URL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DATABASE"

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# **ACTION REQUIRED**: Replace with your Supabase credentials
# Options:
#   1. Use production Supabase (read-only testing)
#   2. Create separate staging Supabase project
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# =============================================================================
# PROTOCOL CONFIGURATION (HTTP for local staging)
# =============================================================================

# HTTP configuration (no SSL needed for local staging)
NEXT_PUBLIC_PROTOCOL_MODE=http
NEXT_PUBLIC_FRONTEND_HOST=localhost
NEXT_PUBLIC_FRONTEND_PORT=3000
NEXT_PUBLIC_BACKEND_HOST=localhost
NEXT_PUBLIC_BACKEND_PORT=5000

# =============================================================================
# NEXTAUTH CONFIGURATION
# =============================================================================

# **ACTION REQUIRED**: Replace with staging-specific values
# NextAuth URL (HTTP for local staging)
NEXTAUTH_URL="http://localhost:3000"

# NextAuth Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="staging-secret-change-this-12345678"

# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================

# Backend API URLs (HTTP for local staging)
API_BASE_URL="http://localhost:5000"
NEXT_PUBLIC_API_URL="http://localhost:5000"

# =============================================================================
# OAUTH PROVIDERS
# =============================================================================

# **ACTION REQUIRED**: Replace with your OAuth credentials
# Note: For staging, you may need to register http://localhost:3000 as redirect URI

# Google OAuth
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# GitHub OAuth (optional)
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# Microsoft OAuth (optional)
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Verbose logging for staging (helps with debugging)
LOG_LEVEL=debug
NEXT_PUBLIC_LOG_LEVEL=debug

# Enable verbose frontend logging
NEXT_PUBLIC_ENABLE_VERBOSE_LOGGING=true

# =============================================================================
# STAGING-SPECIFIC CONFIGURATION
# =============================================================================

# Node environment (DO NOT CHANGE)
NODE_ENV=staging
