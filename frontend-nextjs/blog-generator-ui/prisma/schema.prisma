generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                  String         @id @default(cuid())
  name                String?
  email               String?        @unique
  emailVerified       DateTime?      @map("email_verified")
  image               String?
  role                UserRole       @default(FREE)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  monthlyGenerations  Int            @default(0) @map("monthly_generations")
  lastGenerationReset DateTime       @default(now()) @map("last_generation_reset")
  accounts            Account[]
  auditSessions       AuditSession[]
  blogs               Blog[]
  sessions            Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model Blog {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  topic         String
  instructions  String?
  content       String?
  heroImageUrl  String?        @map("hero_image_url")
  status        BlogStatus     @default(QUEUED)
  progress      Int            @default(0)
  currentStep   String?        @map("current_step")
  error         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  completedAt   DateTime?      @map("completed_at")
  auditSessions AuditSession[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("blogs")
}

model AuditSession {
  id           String    @id @default(cuid())
  blogId       String?   @map("blog_id")
  userId       String    @map("user_id")
  sessionType  String    @map("session_type")
  startTime    DateTime  @map("start_time")
  endTime      DateTime? @map("end_time")
  totalCost    Float     @default(0.0) @map("total_cost")
  totalTokens  Int       @default(0) @map("total_tokens")
  inputTokens  Int       @default(0) @map("input_tokens")
  outputTokens Int       @default(0) @map("output_tokens")
  callCount    Int       @default(0) @map("call_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  blog         Blog?     @relation(fields: [blogId], references: [id])
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  llmCalls     LLMCall[]

  @@map("audit_sessions")
}

model LLMCall {
  id             String       @id @default(cuid())
  auditSessionId String       @map("audit_session_id")
  model          String
  inputTokens    Int          @map("input_tokens")
  outputTokens   Int          @map("output_tokens")
  inputCost      Float        @map("input_cost")
  outputCost     Float        @map("output_cost")
  totalCost      Float        @map("total_cost")
  phase          String
  agentRole      String       @map("agent_role")
  callType       String       @map("call_type")
  timestamp      DateTime     @default(now())
  auditSession   AuditSession @relation(fields: [auditSessionId], references: [id], onDelete: Cascade)

  @@map("llm_calls")
}

enum UserRole {
  FREE
  PREMIUM
  ADMIN
}

enum BlogStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
}
