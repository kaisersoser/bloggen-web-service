# Backend Environment Configuration - DEVELOPMENT
# Copy this to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Local PostgreSQL Docker (Development)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bloggen_dev"

# Supabase Production (for reference)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# =============================================================================
# REDIS CONFIGURATION  
# =============================================================================

# Local Redis Docker (Development)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Upstash Production (for reference)
# REDIS_URL="rediss://USER:PASSWORD@HOST:PORT"

# =============================================================================
# API KEYS
# =============================================================================

# OpenAI API Key (for LLM - GPT-4)
OPENAI_API_KEY=your_openai_api_key_here

# Replicate API Key (for AI image generation - Imagen-3-Fast)
REPLICATE_API_KEY=your_replicate_api_key_here

# Unsplash API Key (for free stock photos fallback)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# =============================================================================
# AWS S3 CONFIGURATION
# =============================================================================

# AWS S3 Configuration for Permanent Image Storage
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_S3_BUCKET_NAME="your-s3-bucket-name"
AWS_S3_REGION="us-east-1"

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================

# Environment (development/staging/production)
ENVIRONMENT="development"

# Frontend URL (HTTPS REQUIRED in all environments)
FRONTEND_URL="https://localhost:3000"

# =============================================================================
# NEXTAUTH CONFIGURATION
# =============================================================================

# NextAuth Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-nextauth-secret-change-this"
NEXTAUTH_URL="https://localhost:3000"

# =============================================================================
# IMAGE GENERATION CONFIGURATION
# =============================================================================

# AI Image Generation Feature Toggles
ENABLE_AI_IMAGE_GENERATION=true          # Master switch for AI image generation
ENABLE_HERO_IMAGE_GENERATION=true        # Generate hero images for blogs
ENABLE_CONTENT_IMAGE_INJECTION=true      # Inject images into blog content

# Provider Selection & Model Configuration
# Supported providers: replicate | openai
# See docs/IMAGE_PROVIDER_GUIDE.md for all available models and cost comparisons
IMAGE_PROVIDER=replicate
IMAGE_MODEL=google/imagen-3-fast
IMAGE_COST_PER_GENERATION=0.025

# Quick Switch Examples:
# ----------------------
# To switch models easily, use: python src/utils/switch_image_provider.py <provider> <model-alias>
# 
# Examples:
#   python src/utils/switch_image_provider.py replicate imagen-3-fast  # Current (recommended)
#   python src/utils/switch_image_provider.py replicate sdxl           # Budget (94% cheaper!)
#   python src/utils/switch_image_provider.py openai dall-e-3          # Premium creative
#   python src/utils/switch_image_provider.py replicate flux-dev       # Balanced quality
#
# Or manually edit these three lines:
# Replicate Imagen-3-Fast (Current): IMAGE_PROVIDER=replicate, IMAGE_MODEL=google/imagen-3-fast, COST=0.025
# Replicate SDXL (Budget):           IMAGE_PROVIDER=replicate, IMAGE_MODEL=stability-ai/sdxl, COST=0.0023
# OpenAI DALL-E 3 (Premium):         IMAGE_PROVIDER=openai, IMAGE_MODEL=dall-e-3, COST=0.040
# Replicate Flux Dev (Balanced):     IMAGE_PROVIDER=replicate, IMAGE_MODEL=black-forest-labs/flux-dev, COST=0.025
#
# See full guide: docs/IMAGE_PROVIDER_GUIDE.md

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# HTTPS enforcement (enabled in all environments)
HTTPS_REQUIRED=true
