# Backend Environment Configuration - STAGING (Windows Docker)
# This file is used when running staging environment on Windows via Docker Compose

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# **ACTION REQUIRED**: Replace with your staging database URL
# Options:
#   1. Use production Supabase (read-only testing)
#   2. Use local PostgreSQL: postgresql://postgres:postgres@localhost:5432/bloggen_staging
#   3. Create separate staging database on Supabase
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DATABASE"

# =============================================================================
# REDIS CONFIGURATION  
# =============================================================================

# **ACTION REQUIRED**: Replace with your Redis configuration
# Options:
#   1. Use production Upstash Redis (staging testing)
#   2. Use local Redis: localhost:6379
REDIS_HOST="localhost"
REDIS_PORT=6379
# If using Upstash with TLS, set these:
# REDIS_URL="rediss://default:YOUR_PASSWORD@YOUR_HOST:6379"
# REDIS_TLS=true

# =============================================================================
# API KEYS (Same for all environments)
# =============================================================================

# **ACTION REQUIRED**: Copy your API keys from production or local .env

# OpenAI API Key (for LLM - GPT-4)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Replicate API Key (for AI image generation - Imagen-3-Fast)
REPLICATE_API_KEY=YOUR_REPLICATE_API_KEY_HERE

# Unsplash API Key (for free stock photos fallback)
UNSPLASH_ACCESS_KEY=YOUR_UNSPLASH_ACCESS_KEY_HERE

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================

# Environment (DO NOT CHANGE)
ENVIRONMENT="staging"

# Port configuration (DO NOT CHANGE - matches Railway's internal port)
PORT=8080

# Frontend URL (HTTP for local staging - no SSL needed)
FRONTEND_URL="http://localhost:3000"

# =============================================================================
# NEXTAUTH CONFIGURATION
# =============================================================================

# **ACTION REQUIRED**: Replace with staging-specific secret
# Generate new secret with: openssl rand -base64 32
NEXTAUTH_SECRET="staging-secret-change-this-12345678"
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# IMAGE GENERATION CONFIGURATION
# =============================================================================

# AI Image Generation Feature Toggles
# Keep these aligned with production settings for accurate staging tests
ENABLE_AI_IMAGE_GENERATION=true
ENABLE_HERO_IMAGE_GENERATION=true
ENABLE_CONTENT_IMAGE_INJECTION=true

# Provider Selection & Model Configuration
IMAGE_PROVIDER=replicate
IMAGE_MODEL=google/imagen-3-fast
IMAGE_COST_PER_GENERATION=0.025

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# HTTPS enforcement (disabled for local staging - HTTP only)
HTTPS_REQUIRED=false

# =============================================================================
# STAGING-SPECIFIC CONFIGURATION
# =============================================================================

# Logging level (more verbose for staging)
LOG_LEVEL=debug

# Enable verbose backend logging
DEBUG=true
