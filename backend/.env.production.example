# ============================================
# PRODUCTION ENVIRONMENT
# ============================================
# Copy this file to .env.production for production deployment
# Set these values in Railway dashboard (DO NOT commit .env.production)

# ============================================
# DATABASE - Supabase PostgreSQL (PRODUCTION)
# ============================================
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_KEY=your_production_supabase_anon_key

# ============================================
# REDIS - Upstash Redis (PRODUCTION)
# ============================================
# Get these from: https://console.upstash.com/
# 
# IMPORTANT: Use 'rediss://' (double-s) for TLS/SSL connections
# Upstash requires TLS in production
REDIS_URL=rediss://default:[PASSWORD]@[YOUR-DB].upstash.io:6379

# Alternative: Upstash REST API (for HTTP-based access)
# Not needed if using standard Redis client (redis.asyncio)
UPSTASH_REDIS_REST_URL=https://[YOUR-DB].upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ============================================
# OPENAI API
# ============================================
OPENAI_API_KEY=sk-your-production-openai-api-key

# ============================================
# AWS S3 (Production)
# ============================================
AWS_ACCESS_KEY_ID=your_production_aws_key
AWS_SECRET_ACCESS_KEY=your_production_aws_secret
AWS_S3_BUCKET=bloggen-production-bucket
AWS_REGION=us-east-1

# ============================================
# UNSPLASH API
# ============================================
UNSPLASH_ACCESS_KEY=your_production_unsplash_key

# ============================================
# AI IMAGE GENERATION (Toggle as needed)
# ============================================
ENABLE_AI_IMAGE_GENERATION=false
ENABLE_HERO_IMAGE_GENERATION=false
ENABLE_CONTENT_IMAGE_INJECTION=false

# ============================================
# SECURITY - Production (MUST BE STRONG!)
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secure-production-secret-min-32-chars
NEXTAUTH_SECRET=your-super-secure-nextauth-secret-min-32-chars
NEXTAUTH_URL=https://yourdomain.com

# ============================================
# APPLICATION SETTINGS
# ============================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# ============================================
# HTTPS (Production)
# ============================================
HTTPS_ENABLED=true
# Railway/Render provides SSL automatically
# No need for SSL_CERT_PATH in production

# ============================================
# CORS - Production Frontend
# ============================================
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
