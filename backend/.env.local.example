# ============================================
# LOCAL DEVELOPMENT ENVIRONMENT
# ============================================
# Copy this file to .env.local for local development
# DO NOT commit .env.local to git

# ============================================
# DATABASE - Local PostgreSQL
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bloggen_dev
SUPABASE_URL=http://localhost:54321  # If using local Supabase
SUPABASE_KEY=your_local_anon_key

# ============================================
# REDIS - Local Redis Server
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ============================================
# OPENAI API
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key

# ============================================
# AWS S3 (Development)
# ============================================
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=bloggen-dev-bucket
AWS_REGION=us-east-1

# ============================================
# UNSPLASH API
# ============================================
UNSPLASH_ACCESS_KEY=your_unsplash_key

# ============================================
# AI IMAGE GENERATION (Toggle as needed)
# ============================================
ENABLE_AI_IMAGE_GENERATION=false
ENABLE_HERO_IMAGE_GENERATION=false
ENABLE_CONTENT_IMAGE_INJECTION=false

# ============================================
# SECURITY - Local Development
# ============================================
JWT_SECRET=local-dev-secret-min-32-characters-long
NEXTAUTH_SECRET=local-dev-nextauth-secret-min-32-chars

# ============================================
# APPLICATION SETTINGS
# ============================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=debug
HTTPS_ENABLED=true

# ============================================
# CORS - Local Frontend
# ============================================
CORS_ORIGINS=https://localhost:3000,http://localhost:3000

# ============================================
# SSL/TLS - Local Development
# ============================================
SSL_CERT_PATH=../certs/localhost.pem
SSL_KEY_PATH=../certs/localhost-key.pem
